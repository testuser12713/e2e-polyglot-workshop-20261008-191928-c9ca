{
  "runcontract": 1,
  "services": [
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "valkey",
      "kind": "database",
      "engine": "valkey"
    },
    {
      "name": "worker",
      "dir": "worker",
      "stack": "python",
      "kind": "worker",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-e",
          "."
        ]
      ],
      "start": [
        "${python}",
        "-m",
        "worker"
      ],
      "test": [
        [
          "${python}",
          "-m",
          "pytest"
        ]
      ],
      "env": {
        "DATABASE_URL": {
          "dev": "${service:db.url}"
        },
        "VALKEY_URL": {
          "dev": "${service:valkey.url}"
        },
        "QUEUE_NAME": {
          "dev": "workshop-invoices"
        },
        "HOURLY_RATE_CENTS": {
          "dev": "8900"
        }
      },
      "depends_on": [
        "db",
        "valkey"
      ]
    },
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        [
          "npm",
          "ci"
        ]
      ],
      "build": [
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "start": [
        "npm",
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "${PORT}"
      ],
      "test": [
        [
          "npm",
          "test"
        ]
      ],
      "port": 5173,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [
          200
        ]
      },
      "env": {
        "VITE_API_BASE_URL": {
          "dev": "${service:api.origin}"
        }
      }
    },
    {
      "name": "api",
      "dir": "backend",
      "stack": "go",
      "kind": "server",
      "install": [
        [
          "go",
          "mod",
          "download"
        ]
      ],
      "build": [
        [
          "go",
          "build",
          "./..."
        ]
      ],
      "test": [
        [
          "go",
          "test",
          "./..."
        ]
      ],
      "start": [
        "go",
        "run",
        "."
      ],
      "port": 8080,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [
          200
        ]
      },
      "ready_timeout_s": 90,
      "depends_on": [
        "db",
        "valkey"
      ],
      "env": {
        "GOTOOLCHAIN": {
          "dev": "auto"
        },
        "DATABASE_URL": {
          "dev": "${service:db.url}"
        },
        "VALKEY_URL": {
          "dev": "${service:valkey.url}"
        },
        "QUEUE_NAME": {
          "dev": "workshop-invoices"
        },
        "HOURLY_RATE_CENTS": {
          "dev": "8900"
        },
        "AUTH_SECRET": {
          "generate": "hex",
          "bytes": 32
        },
        "EMPLOYEE_EMAIL": {
          "dev": "meister@example.com"
        },
        "EMPLOYEE_PASSWORD": {
          "dev": "changeme",
          "not_secret": true,
          "why": "Published demo account for the local workshop login (see README, section 'Starten (Entwicklung)'). Intentionally committed so the documented login works out of the box; it grants access only to the locally seeded demo employee and is not a real secret."
        },
        "CORS_ORIGIN": {
          "dev": "${service:web.origin}"
        }
      }
    }
  ]
}
