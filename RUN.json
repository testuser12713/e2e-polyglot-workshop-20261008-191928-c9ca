{
  "runcontract": 1,
  "services": [
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "valkey",
      "kind": "database",
      "engine": "valkey"
    },
    {
      "name": "worker",
      "dir": "worker",
      "stack": "python",
      "kind": "worker",
      "install": [
        ["${python}", "-m", "pip", "install", "-e", "."]
      ],
      "start": ["${python}", "-m", "worker"],
      "test": [
        ["${python}", "-m", "pytest"]
      ],
      "env": {
        "DATABASE_URL": {"dev": "${service:db.url}"},
        "VALKEY_URL": {"dev": "${service:valkey.url}"},
        "QUEUE_NAME": {"dev": "workshop-invoices"},
        "HOURLY_RATE_CENTS": {"dev": "8900"}
      },
      "depends_on": ["db", "valkey"]
    }
  ]
}
